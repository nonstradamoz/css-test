# ==============================================================================
# Centralised Expense & Refund Management System (CRS) - Environment Variables
# ==============================================================================

# --- Database (PostgreSQL) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=crs_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/crs_db

# --- Caching, Queues & Distributed Locks (Redis) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Security & JWT Authentication ---
JWT_SECRET_KEY=change-this-in-production-super-secret-jwt-key-min-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Cloudflare R2 (S3-Compatible Object Storage) ---
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=crs-receipts
R2_ENDPOINT_URL=https://your_cloudflare_account_id.r2.cloudflarestorage.com
R2_PUBLIC_DOMAIN=https://pub-your_r2_subdomain.r2.dev

# --- Multimodal AI Receipt Vision (Google Gemini) ---
USE_GEMINI_API=True
GEMINI_API_KEY=your_gemini_api_key_optional
GEMINI_MODEL=gemini-1.5-flash

# --- Refund Provider Simulation (SUCCESS | FAILURE | TIMEOUT) ---
MOCK_REFUND_OUTCOME=SUCCESS

# --- Google OAuth Authentication ---
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_optional
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# --- Frontend Client Config ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
